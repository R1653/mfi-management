# Hostinger Node.js Webserver Configuration
DirectoryIndex index.html

# Prevent displaying server source files in browser
<FilesMatch "\.(js|json|sqlite3|env|log)$">
    # Allow static JS in public folder but deny server root script execution as plain text
</FilesMatch>

<IfModule mod_passenger.c>
  PassengerEngine on
  PassengerAppType node
  PassengerStartupFile server.js
</IfModule>

