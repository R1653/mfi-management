# Hostinger Webserver & SPA Configuration
DirectoryIndex public/index.html index.html

# Prevent server source files from being served as plain text
<FilesMatch "^(server\.js|\.env|\.gitignore|package\.json|package-lock\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy API endpoints to local Node.js process on port 3000
  RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,QSA,L]

  # Serve existing physical files directly from public directory
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  # Route root and all SPA frontend routes (/login, /dashboard, /mfi, etc.) to public/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ public/index.html [L]
</IfModule>



