# Hostinger Node.js & Proxy Configuration
DirectoryIndex public/index.html index.html

# Prevent server source files from being served as plain text
<FilesMatch "^(server\.js|\.env|\.gitignore|package\.json|package-lock\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Preserve Domain Host and Session Cookies across Proxy
<IfModule mod_proxy.c>
  ProxyPreserveHost On
  ProxyPassReverse / http://127.0.0.1:3000/
  ProxyPassReverseCookiePath / /
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing physical files directly from public directory
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(css|js|images|assets|uploads)/(.*)$ public/$1/$2 [L]

  # Route all application pages and API endpoints to Node.js on port 3000
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,QSA,L]
</IfModule>



